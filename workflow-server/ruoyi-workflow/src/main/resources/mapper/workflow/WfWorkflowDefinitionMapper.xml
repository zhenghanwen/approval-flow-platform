<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.workflow.mapper.WfWorkflowDefinitionMapper">

    <resultMap type="WfWorkflowDefinition" id="WfWorkflowDefinitionResult">
        <id     property="id"                    column="id"/>
        <result property="approvalDefinitionId"  column="approval_definition_id"/>
        <result property="workflowCode"          column="workflow_code"/>
        <result property="workflowName"          column="workflow_name"/>
        <result property="status"                column="status"/>
        <result property="currentVersion"        column="current_version"/>
        <result property="createdBy"             column="created_by"/>
        <result property="createdAt"             column="created_at"/>
        <result property="updatedAt"             column="updated_at"/>
    </resultMap>

    <sql id="selectWfWorkflowDefinitionVo">
        select id, approval_definition_id, workflow_code, workflow_name,
               status, current_version, created_by, created_at, updated_at
        from wf_workflow_definition
    </sql>

    <select id="selectById" parameterType="String" resultMap="WfWorkflowDefinitionResult">
        <include refid="selectWfWorkflowDefinitionVo"/>
        where id = #{id}
    </select>

    <select id="selectByCode" parameterType="String" resultMap="WfWorkflowDefinitionResult">
        <include refid="selectWfWorkflowDefinitionVo"/>
        where workflow_code = #{workflowCode}
    </select>

    <select id="selectByApprovalDefinition" parameterType="String" resultMap="WfWorkflowDefinitionResult">
        <include refid="selectWfWorkflowDefinitionVo"/>
        where approval_definition_id = #{approvalDefinitionId}
        order by created_at desc
    </select>

    <select id="selectList" parameterType="WfWorkflowDefinition" resultMap="WfWorkflowDefinitionResult">
        <include refid="selectWfWorkflowDefinitionVo"/>
        <where>
            <if test="workflowCode != null and workflowCode != ''">and workflow_code like concat('%', #{workflowCode}, '%')</if>
            <if test="workflowName != null and workflowName != ''">and workflow_name like concat('%', #{workflowName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by created_at desc
    </select>

    <insert id="insert" parameterType="WfWorkflowDefinition">
        insert into wf_workflow_definition
            (id, approval_definition_id, workflow_code, workflow_name, status, current_version, created_by)
        values
            (#{id}, #{approvalDefinitionId}, #{workflowCode}, #{workflowName}, #{status}, #{currentVersion}, #{createdBy})
    </insert>

    <update id="update" parameterType="WfWorkflowDefinition">
        update wf_workflow_definition
        <set>
            <if test="workflowName != null">workflow_name = #{workflowName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="currentVersion != null">current_version = #{currentVersion},</if>
        </set>
        where id = #{id}
    </update>

</mapper>
