<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://workflow.spike/bpmn">

    <process id="spikeAddSignProcess" name="S2加签测试（审批人列表collection驱动的并行MI+ALL规则）">
        <startEvent id="start"/>
        <sequenceFlow id="f0" sourceRef="start" targetRef="apply"/>
        <userTask id="apply" name="填写申请" flowable:assignee="applicant"/>
        <sequenceFlow id="f1" sourceRef="apply" targetRef="financeApproval"/>
        <userTask id="financeApproval" name="财务审批" flowable:assignee="${wfUser}">
            <multiInstanceLoopCharacteristics isSequential="false">
                <loopDataInputRef>wf_users_financeApproval</loopDataInputRef>
                <inputDataItem name="wfUser"/>
                <completionCondition>${nrOfCompletedInstances == nrOfInstances}</completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>
        <sequenceFlow id="f2" sourceRef="financeApproval" targetRef="end"/>
        <endEvent id="end"/>
    </process>

</definitions>
