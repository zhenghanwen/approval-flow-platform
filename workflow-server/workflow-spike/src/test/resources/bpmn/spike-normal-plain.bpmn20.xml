<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://workflow.spike/bpmn">

    <process id="spikeNormalPlain" name="S5规一化输入（未做统一MI建模的普通串行审批）">
        <startEvent id="start"/>
        <sequenceFlow id="f0" sourceRef="start" targetRef="apply"/>
        <userTask id="apply" name="填写申请" flowable:assignee="applicant"/>
